[Unit]
Description=Attendance API (FastAPI)
After=network-online.target
[Service]
User=attendance
WorkingDirectory=/srv/attendance/app
EnvironmentFile=/srv/attendance/app/.env
ExecStart=/srv/attendance/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
